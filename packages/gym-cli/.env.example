# Copy to packages/gym-cli/.env and fill in — required for `review-new` / `review-score`
# to act through the GitHub bot (branch, push, open PR, post grade). Never commit .env.

# A personal access token for the dedicated bot GitHub account, scoped to `repo` on GITHUB_REPO.
GYM_BOT_GH_TOKEN=

# The owner (your GitHub username or org) and name of the repo the bot opens PRs against.
GITHUB_OWNER=
GITHUB_REPO=
