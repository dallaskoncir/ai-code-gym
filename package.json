{
  "name": "fintech-gym",
  "version": "1.0.0",
  "description": "Turborepo monorepo housing the AI Code Gym CLI and a dummy fintech practice app used as a realistic mutation target for review-mode exercises.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "gym": "pnpm --filter @fintech-gym/cli run gym"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
